# Modèle servi par Ollama. Le plan prévoit le 7b (GPU / Colab) ;
# sur un PC sans carte graphique, utiliser qwen2.5vl:3b.
MODEL_NAME=qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434

# Approche : vision (Qwen-VL lit l'image) ou ocr (lecture du texte puis Qwen range les champs)
APPROCHE=ocr
# Moteur OCR : rapidocr (tourne partout) ou paddleocr_vl (Python 3.8-3.12, GPU conseillé)
OCR_MOTEUR=rapidocr
OCR_SCORE_MIN=0.75

# Signalement des champs douteux : confiance OCR minimale
SEUIL_DOUTE_OCR=0.9

TAILLE_MAX_MO=20
IMAGE_MAX_PX=1280
PDF_MAX_PAGES=3
NUM_CTX=8192
KEEP_ALIVE=30m

